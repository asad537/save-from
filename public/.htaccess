<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Send every alternate host to the single canonical, non-www HTTPS URL.
    RewriteCond %{HTTP_HOST} !^save-froms\.net$ [NC]
    RewriteRule ^ https://save-froms.net%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The sitemap is generated from the published database records on every request.
    # This rule intentionally runs before Apache can serve a stale sitemap.xml file.
    RewriteRule ^sitemap\.xml$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>

<IfModule mod_headers.c>
    <Files "sitemap.xml">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </Files>
</IfModule>
